/* PythonOS Dark — a theme inspired by KDE Breeze Dark's palette and
   measurements, written independently (see docs/DESKTOP.md for the
   licensing note). Values are substituted by ThemeManager from
   theme.json at load time via {token} placeholders. */

QWidget {
    background-color: {window_bg};
    color: {text};
    font-family: "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 10pt;
}

QWidget#Panel {
    background-color: {panel_bg};
    border-top: 1px solid {border};
}

QPushButton#LauncherButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: 600;
    color: {text};
}
QPushButton#LauncherButton:hover {
    background-color: {button_hover};
}
QPushButton#LauncherButton:pressed {
    background-color: {accent};
    color: {selection_text};
}

QPushButton#TaskButton {
    background-color: {button_bg};
    border: 1px solid {border};
    border-radius: 3px;
    padding: 2px 10px;
    text-align: left;
    color: {text};
}
QPushButton#TaskButton:hover {
    background-color: {button_hover};
}

QLabel#ClockLabel {
    color: {text};
    padding: 0 10px;
    font-weight: 500;
}

QLabel#TrayItem {
    color: {text};
    padding: 0 6px;
}

QWidget#Launcher {
    background-color: {view_bg};
    border: 1px solid {border};
}

QListWidget#CategoryList {
    background-color: {panel_bg};
    border: none;
    outline: none;
}
QListWidget#CategoryList::item {
    padding: 8px 12px;
    border-radius: 4px;
    margin: 2px 4px;
}
QListWidget#CategoryList::item:selected {
    background-color: {accent};
    color: {selection_text};
}
QListWidget#CategoryList::item:hover:!selected {
    background-color: {button_hover};
}

QListWidget#AppList {
    background-color: {view_bg};
    border: none;
    outline: none;
}
QListWidget#AppList::item {
    padding: 6px 10px;
    border-radius: 4px;
}
QListWidget#AppList::item:selected {
    background-color: {accent};
    color: {selection_text};
}
QListWidget#AppList::item:hover:!selected {
    background-color: {button_hover};
}

QLineEdit#SearchBox {
    background-color: {button_bg};
    border: 1px solid {border};
    border-radius: 14px;
    padding: 6px 12px;
    color: {text};
    selection-background-color: {selection_bg};
}
QLineEdit#SearchBox:focus {
    border: 1px solid {accent};
}
